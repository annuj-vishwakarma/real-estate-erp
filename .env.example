# ---------- API (apps/api) ----------
NODE_ENV=development
PORT=4000
# Transactions require a replica set. `npm run db:local` or `docker compose up -d mongo` starts one.
MONGODB_URI=mongodb://127.0.0.1:27017/real_estate_erp?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-dev-only-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173
# Secure cookies default to true in production; set false only for plain-http local testing
# COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting)
TRUST_PROXY=0
LOG_LEVEL=info
# SMTP for verification / reset / invitation emails (logged to console when unset in development)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="Real Estate ERP <no-reply@example.com>"
JOBS_ENABLED=true
RESERVATION_EXPIRY_CRON=*/5 * * * *
INSTALLMENT_REMINDER_CRON=30 3 * * *
REMINDER_DAYS_AHEAD=7
# CRM follow-up reminders (in-app notifications for due follow-ups)
FOLLOWUP_REMINDER_CRON=*/30 * * * *
LOGIN_RATE_LIMIT_PER_15_MIN=10

# ---------- Document storage ----------
# local: files on disk under STORAGE_LOCAL_DIR, served through HMAC-signed expiring links (single server / dev).
# s3: private S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) with presigned GET links. Recommended for production.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
# S3_BUCKET=my-erp-documents
# S3_REGION=ap-south-1
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false                                 # true for MinIO
MAX_UPLOAD_MB=15
# Lifetime of view/download links
FILE_URL_TTL_SECONDS=300

# ---------- Web (apps/web) ----------
# API base used by the browser. In development Vite proxies /api to the API, so leave as /api/v1.
VITE_API_BASE_URL=/api/v1
